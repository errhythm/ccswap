#!/usr/bin/python3
"""A stand-in ccswap with made-up Claude Code and Codex accounts, for Raycast screenshots.

Point the extension's "ccswap Path" preference at this file. It answers the only
commands the extension runs (`list --json`, `switch`, `codex switch`) and keeps
the active account in $TMPDIR so switches persist between calls. Delete the
state file to reset: rm "$TMPDIR/raycast-fake-ccswap.json"
"""

import json
import os
import sys
import tempfile

STATE = os.path.join(tempfile.gettempdir(), "raycast-fake-ccswap.json")


def window(pct, countdown):
    return {"pct": pct, "countdown": countdown}


ACCOUNTS = {
    "claude": [
        {"number": 1, "email": "alex@example.com", "organizationName": "Acme Labs",
         "usage": {"fiveHour": window(34.0, "2h 41m"), "sevenDay": window(52.0, "3d 6h")}},
        {"number": 2, "email": "sam@example.dev", "alias": "personal", "organizationName": "",
         "usage": {"fiveHour": window(8.0, "4h 12m"), "sevenDay": window(21.0, "5d 2h")}},
        {"number": 3, "email": "jordan@example.org", "organizationName": "Globex",
         "usage": {"fiveHour": window(93.0, "38m"), "sevenDay": window(88.0, "1d 9h")}},
        {"number": 4, "email": "taylor@example.net", "organizationName": "Initech", "disabled": True,
         "usage": {"fiveHour": window(0.0, "5h"), "sevenDay": window(71.0, "2d 4h")}},
    ],
    "codex": [
        {"number": 1, "email": "alex@example.com", "organizationName": "",
         "usage": {"fiveHour": window(12.0, "3h 5m"), "weekly": window(41.0, "4d 1h")}},
        {"number": 2, "email": "dev@example.io", "organizationName": "",
         "usage": {"fiveHour": window(77.0, "1h 2m"), "weekly": window(76.0, "2d 18h")}},
    ],
}


def load_active():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"claude": 1, "codex": 1}


def save_active(active):
    with open(STATE, "w") as f:
        json.dump(active, f)


def section(provider, active):
    rows = [{**a, "active": a["number"] == active[provider], "usageStatus": "ok"} for a in ACCOUNTS[provider]]
    if provider == "claude":
        return {"schemaVersion": 1, "activeAccountNumber": active[provider], "accounts": rows}
    return {"provider": "codex", "activeAccountNumber": active[provider], "accounts": rows}


def best(provider, current):
    # Most headroom: lowest of the tighter window, skipping disabled and current.
    candidates = [a for a in ACCOUNTS[provider] if not a.get("disabled") and a["number"] != current]
    return min(candidates, key=lambda a: max(w["pct"] for w in a["usage"].values()))["number"]


def switch(provider, args, active):
    current = active[provider]
    if "--strategy" in args:
        target = best(provider, current)
    else:
        number = next((a for a in args if a.isdigit()), None)
        known = {a["number"] for a in ACCOUNTS[provider]}
        if number is None or int(number) not in known:
            print(json.dumps({"schemaVersion": 1, "error": {"type": "AccountNotFoundError",
                                                             "message": f"No account {number}"}}))
            sys.exit(1)
        target = int(number)
    active[provider] = target
    save_active(active)
    email = next(a["email"] for a in ACCOUNTS[provider] if a["number"] == target)
    print(json.dumps({"from": {"number": current}, "to": {"number": target, "email": email}, "warnings": []}))


def main(argv):
    active = load_active()
    if argv[:1] == ["--version"]:
        print("ccswap 0.46.0")
    elif argv[:1] == ["list"]:
        print(json.dumps({p: section(p, active) for p in ("claude", "codex")}))
    elif argv[:1] == ["switch"]:
        switch("claude", argv[1:], active)
    elif argv[:2] == ["codex", "switch"]:
        switch("codex", argv[2:], active)
    else:
        print(f"fake ccswap: unsupported command: {' '.join(argv)}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
